# Copier ce fichier en .env puis adapter les valeurs :  cp .env.example .env

# Ports exposés sur votre machine
PG_PORT=15432
MONGO_PORT=27018
REDIS_PORT=16379
NEO4J_HTTP_PORT=17474
NEO4J_BOLT_PORT=17687
API_PORT=5199

# Identifiants des moteurs (obligatoires)
POSTGRES_USER=pixelhub
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pixelhub

MONGO_USER=pixelhub
MONGO_PASSWORD=changeme

# Neo4j : mot de passe de 8 caractères minimum
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
