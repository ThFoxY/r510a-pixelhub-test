# Carnet de tests PixelHub — cliquer sur « Send request » au-dessus de chaque bloc.
# Port : celui affiché par `dotnet run` (5199 via launchSettings.json),
# et aussi celui de l'API conteneurisée (docker compose --profile app up -d).
@host = http://localhost:5199

### Santé
GET {{host}}/

### Séance 1 — PostgreSQL
GET {{host}}/players
Accept: application/json

### Séance 1 — bonus : créer un joueur
POST {{host}}/players
Content-Type: application/json

{ "pseudo": "Pixel", "coins": 500 }

### Séance 2 — MongoDB : catalogue complet
GET {{host}}/games
Accept: application/json

### Séance 2 — filtrage par genre
GET {{host}}/games/genre/FPS
Accept: application/json

### Séance 2 — top 3
GET {{host}}/games/top/3
Accept: application/json

### Séance 2 — agrégation : note moyenne par genre
GET {{host}}/games/stats
Accept: application/json

### Séance 3 — leaderboard : attribuer des points à Nova
POST {{host}}/leaderboard/Nova/points/100
Content-Type: application/json

### Séance 3 — leaderboard : attribuer des points à Ombre
POST {{host}}/leaderboard/Ombre/points/200
Content-Type: application/json

### Séance 3 — leaderboard : attribuer des points à Krayz
POST {{host}}/leaderboard/Krayz/points/10
Content-Type: application/json

### Séance 3 — top 3 du classement
GET {{host}}/leaderboard/top/3
Content-Type: application/json

### Séance 3 — top 5 du classement
GET {{host}}/leaderboard/top/5
Content-Type: application/json

### Séance 3 — rang d'un joueur
GET {{host}}/leaderboard/rank/Ombre
Content-Type: application/json

### Séance 4 — amis d'un joueur
GET {{host}}/social/Krayz/friends
Content-Type: application/json

### Séance 4 — recommandations pour un joueur
GET {{host}}/social/Nova/recommendations
Content-Type: application/json

### Séance 4 — recommandations pour un joueur (profondeur 3)
GET {{host}}/social/Nova/recommendations?depth=3
Content-Type: application/json

### Séance 4 — suggestions de jeux
GET {{host}}/social/Luna/friend-suggestions
Content-Type: application/json
